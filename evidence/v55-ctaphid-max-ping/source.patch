+
+TEST_CASE("final legal sequence 127 completes a CTAPHID message", "[hid]") {
+  for (const std::size_t size : {std::size_t{7550}, std::size_t{7551}, swpk::ctap::kMaxMessage}) {
+    HidFramer f;
+    std::vector<std::uint8_t> payload(size);
+    for (std::size_t i = 0; i < size; ++i) payload[i] = static_cast<std::uint8_t>(i);
+    const auto frames = f.frame(Message{0x01020304, swpk::ctap::kCmdPing, payload});
+    REQUIRE(frames.size() == (size == 7550 ? 128 : 129));
+    for (std::size_t i = 0; i + 1 < frames.size(); ++i) {
+      const auto partial = f.ingest(frames[i]);
+      REQUIRE(partial.has_value());
+      REQUIRE_FALSE(partial->has_value());
+    }
+    const auto done = f.ingest(frames.back());
+    REQUIRE(done.has_value());
+    REQUIRE(done->has_value());
+    REQUIRE((*done)->payload == payload);
+  }
 }
 
