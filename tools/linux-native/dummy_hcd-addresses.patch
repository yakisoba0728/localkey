+static struct usb_ep *dummy_match_ep(struct usb_gadget *gadget,
+		struct usb_endpoint_descriptor *desc,
+		struct usb_ss_ep_comp_descriptor *comp)
+{
+	struct usb_ep *ep;
+	u8 number = desc->bEndpointAddress & USB_ENDPOINT_NUMBER_MASK;
+
+	if (!requested_ep_addresses || !number)
+		return NULL;
+	list_for_each_entry(ep, &gadget->ep_list, ep_list) {
+		char *direction;
+		unsigned long allocated;
+
+		if (!strstr(ep->name, "-requested"))
+			continue;
+		allocated = simple_strtoul(ep->name + 2, &direction, 10);
+		if (allocated != number || strcmp(direction,
+			usb_endpoint_dir_in(desc) ? "in-requested" : "out-requested"))
+			continue;
+		if (usb_gadget_ep_match_desc(gadget, ep, desc, comp))
+			return ep;
+	}
+	return NULL;
+}
+
 static const struct usb_gadget_ops dummy_ops = {
+	.match_ep	= dummy_match_ep,
 	.get_frame	= dummy_g_get_frame,
 	.wakeup		= dummy_wakeup,
 	.set_selfpowered = dummy_set_selfpowered,
